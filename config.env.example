# Configurações do PicSafe AI
# Copie este arquivo para config.env e preencha com suas chaves reais

OPENAI_API_KEY=your_openai_api_key_here

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000

# Configurações do modelo de visão
MODEL_VERSION=v1.0.0
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.45

# Configurações de logging
LOG_LEVEL=INFO

# Configurações de privacidade/retention (dias)
IMAGE_RETENTION_DAYS=30