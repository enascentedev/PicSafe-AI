# Configurações do PicSafe AI
# Copie este arquivo para config.env e ajuste os valores.
# config.env está no .gitignore e nunca deve ser versionado nem copiado
# para dentro da imagem Docker.

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000

# Configurações do modelo de visão
MODEL_VERSION=v1.0.0
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.45

# Configurações de logging
LOG_LEVEL=INFO

# Configurações de privacidade/retenção (dias)
# ATENÇÃO: esta variável está prevista na configuração, mas a rotina de expurgo
# ainda NÃO foi implementada — ver "Estado atual" no README. Hoje as imagens
# enviadas são apagadas logo após o processamento, enquanto as imagens anotadas
# e os relatórios HTML permanecem em reports/ por tempo indeterminado.
IMAGE_RETENTION_DAYS=30
